<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>FridgeGranvirStats</AssemblyName>
    <RootNamespace>FridgeGranvirStats</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Description>Fridge Granvir Stats — local HTTP stats bridge for Stream Core</Description>
  </PropertyGroup>

  <!-- After installing BepInEx + Granvir, set GRANVIR_DIR to the game root. -->
  <PropertyGroup>
    <GranvirDir Condition="'$(GranvirDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Granvir</GranvirDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GranvirDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GranvirDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GranvirDir)\Granvir_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GranvirDir)\Granvir_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
