<Project Sdk="Microsoft.NET.Sdk">
  <!-- FridgeRegulars: ten extra customer NPCs for Schedule I (S1API custom NPCs), a separate mod
       next to FridgeSchedule1 so leaving this DLL out turns them off. See Regulars.cs and ../README.md.
       Build on the PC that has the game, MelonLoader (after one start) and S1API:
         dotnet build -c Release [-p:GameDir="D:\SteamLibrary\steamapps\common\Schedule I"]
       Same GameDir / references as ../mod/FridgeSchedule1.csproj; keep the two in step. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FridgeRegulars</AssemblyName>
    <RootNamespace>FridgeRegulars</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Description>FridgeRegulars: ten regular customers for chatter names</Description>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Schedule I</GameDir>
    <MelonDir>$(GameDir)\MelonLoader\net6</MelonDir>
    <Il2CppDir>$(GameDir)\MelonLoader\Il2CppAssemblies</Il2CppDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(MelonDir)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(MelonDir)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(Il2CppDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppScheduleOne.Core"><HintPath>$(Il2CppDir)\Il2CppScheduleOne.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(Il2CppDir)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Il2CppDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppFishNet.Runtime"><HintPath>$(Il2CppDir)\Il2CppFishNet.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="S1API"><HintPath>$(GameDir)\Mods\S1API.Il2Cpp.MelonLoader.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Copy the built DLL into the game's Mods folder (turn off with -p:CopyToGame=false). -->
  <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(CopyToGame)' != 'false' And Exists('$(GameDir)\Mods')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
  </Target>
</Project>
